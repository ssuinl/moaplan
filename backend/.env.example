# 이 파일을 복사해 .env 로 만든 뒤 키를 붙여 넣으세요.
#   Windows:  copy .env.example .env      macOS/Linux:  cp .env.example .env
# .env 는 git · 제출물 · 화면 공유에 올리지 않습니다 (.gitignore 에 들어 있음).

# SSAFY GMS 키 (LLM · 임베딩). 비워 두면 규칙 기반 대역 LLM 으로 동작합니다.
GMS_API_KEY=
GMS_MODEL=gpt-5.4-nano

# 금융감독원 금융상품 한눈에 오픈API 인증키 (finlife.fss.or.kr → 오픈API → 인증키 신청)
FINLIFE_API_KEY=
# 한국은행 ECOS Open API 인증키 (ecos.bok.or.kr/api → 인증키 신청)
ECOS_API_KEY=
# 카카오 REST API 키 (developers.kakao.com → 내 애플리케이션 → 앱 키)
KAKAO_REST_API_KEY=

# 1 이면 키 없이 연습 데이터(backend/tools/fixtures)로 동작
MOAPLAN_FAKE=0
# 캘린더 구현체: local(기본) | google (backend/data/credentials.json 필요)
MOAPLAN_CALENDAR=local
